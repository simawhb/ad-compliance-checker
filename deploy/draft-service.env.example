# 仅供独立起草服务使用；实际文件放在 /etc/sima-draft.env，权限应为 0600。
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_API_KEY=replace-with-controlled-secret
DEEPSEEK_MODEL=deepseek-v4-pro
AD_COMPLIANCE_RULES_DIR=/opt/sima-draft/rules
CORS_ALLOWED_ORIGINS=https://draft.4ma.wang
STORE_REVIEW_RESULTS=false
