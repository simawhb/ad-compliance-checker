server {
    listen 80;
    server_name draft.4ma.wang;

    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/4ma.wang;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name draft.4ma.wang;

    ssl_certificate /etc/letsencrypt/live/draft.4ma.wang/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/draft.4ma.wang/privkey.pem;

    server_tokens off;
    client_max_body_size 64k;
    access_log off;
    error_log /var/log/nginx/sima-draft-error.log warn;
    limit_req_log_level notice;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'none'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()" always;

    location ~ ^/(docs|redoc|openapi.json)$ {
        return 404;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:8012;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
    }

    location = /api/draft {
        limit_req zone=sima_draft_api burst=2 nodelay;
        limit_req_status 429;
        limit_conn sima_draft_conn 2;
        proxy_pass http://127.0.0.1:8012;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 75s;
        proxy_send_timeout 15s;
    }

    location / {
        limit_req zone=sima_draft_api burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8012;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
}
