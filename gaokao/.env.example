# 驷马报考 环境配置
# 复制本文件为 .env 并填入真实值

# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务器配置
HOST=127.0.0.1
PORT=8000
RELOAD=false                          # 开发模式设为 true，生产关闭
LOG_LEVEL=info

# CORS 允许的来源（逗号分隔）
# 生产环境请锁定具体域名，例如：https://gaokao.example.com
CORS_ORIGINS=http://127.0.0.1:8000

# 数据库路径（相对项目根目录）
DB_PATH=data/simadb/gaokao.db
