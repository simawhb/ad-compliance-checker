# 仅在本机 .env 填写真实值；.env 不会提交。
DEEPSEEK_API_KEY=
# 可选：兼容 OpenAI 风格的模型接口地址
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
# 可按账户实际可用模型调整；默认 deepseek-v4-pro。
DEEPSEEK_MODEL=deepseek-v4-pro
# Obsidian 已核验规则目录（本机绝对路径）
AD_COMPLIANCE_RULES_DIR=/Users/a1234/Desktop/sima/05_其他工作文件/广告合规产品协同/规则库/02_已核验规则
# 生产环境必须填入正式网页域名；本机默认仅允许 localhost。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# 内部实验功能，客户文字审查版必须保持 false。
ENABLE_EXPERIMENTAL_MULTIMODAL=false
# 默认不在服务端保存审查结果；仅在明确需要结果查询/PDF时评估后开启。
STORE_REVIEW_RESULTS=false
